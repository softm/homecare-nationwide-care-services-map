/** SOFTM-HOMECARE-PILOT START 날짜:20261121 : 기관 D1은 유지하고 카드 없는 Supabase 비공개 사진 저장소로 연결 준비 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softm-homecare-pilot",
  "account_id": "324650409b822e9887bee48b932b4d71",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "softm-homecare-pilot",
      "database_id": "b1068cbf-7f1e-4c28-99ea-8fb65da84b3c",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "ACCOUNT",
      "service": "softm-homecare-members"
    }
  ],
  "vars": {
    "FILE_STORAGE_PROVIDER": "supabase",
    "SUPABASE_URL": "https://feaouitfpiqjjqdxrtfx.supabase.co",
    "SUPABASE_PHOTOS_BUCKET": "homecare-photos",
    // SOFTM-MEMBER-LIVE 날짜:20261121 : 승인된 기관 담당자의 사진 등록 개방
    "FILE_UPLOADS_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://dolbomhannun.kr,https://homecare.designboard.net,https://softm.github.io",
    "MAX_PHOTO_BYTES": "5242880",
    "MAX_PHOTOS_PER_INSTITUTION": "10"
  },
  "triggers": {
    "crons": ["17 18 * * *"]
  }
}
/** SOFTM-HOMECARE-PILOT END */
