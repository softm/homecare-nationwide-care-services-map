/** SOFTM-HOMECARE-PILOT START 날짜:20261120 : 실제 전용 계정·APAC 기관 D1과 회원 서비스 바인딩을 연결 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softm-homecare-pilot",
  "account_id": "324650409b822e9887bee48b932b4d71",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "softm-homecare-pilot",
      "database_id": "b1068cbf-7f1e-4c28-99ea-8fb65da84b3c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "softm-homecare-pilot-photos"
    }
  ],
  "services": [
    {
      "binding": "ACCOUNT",
      "service": "softm-homecare-members"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://homecare.designboard.net,https://softm.github.io",
    "MAX_PHOTO_BYTES": "5242880",
    "MAX_PHOTOS_PER_INSTITUTION": "10"
  },
  "triggers": {
    "crons": ["17 18 * * *"]
  }
}
/** SOFTM-HOMECARE-PILOT END */
